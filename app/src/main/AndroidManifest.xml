<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App listing and launching. Required for a launcher to show installed apps. -->
    <!--
      Lint flags this by default, correctly: most apps must use a <queries>
      declaration instead, and Play refuses QUERY_ALL_PACKAGES for them.

      A launcher is one of the documented exceptions — Ciyato's core function is
      showing, categorising and launching everything installed, which a filtered
      <queries> list cannot express. The suppression is scoped to this single
      element rather than disabling the check, so any OTHER misuse still fails
      the build, and the Play declaration decision is recorded in
      PLAY_RELEASE_EVIDENCE.md (F-191).

      This is an acknowledgement, not a dismissal: if the declaration is refused,
      the permission has to go and the app must fall back to <queries>.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Required on Android 9+ for the system uninstall dialog to accept our request. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Ciyato Files/Photos: device-wide browsing via MediaStore. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 14 "Select photos" partial-access grant. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Optional: full file-manager mode (Documents/Downloads/APK categories). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Network is used by Weather only when that screen/widget is opened. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground location: requested only from Weather, after an in-app explanation. -->
    <!--
      Approximate location only.

      ACCESS_FINE_LOCATION was declared and used to prefer the GPS provider, but
      WeatherRepository rounds every coordinate to two decimals (~1.1 km) before
      it leaves the device. GPS resolves to a few metres, so that precision was
      acquired, paid for in battery and in a scarier permission prompt, and then
      thrown away — while obliging a "precise location" entry in the Play data
      safety form for a benefit no user ever received.

      FOREGROUND_SERVICE was removed at the same time: it was declared and the
      app contains no startForeground, no ForegroundInfo and no foreground
      service of any kind. A permission the app cannot exercise is a liability
      at review and nothing else.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <!-- No background location. Android lets the person choose precise or approximate access. -->

    <!-- Haptic feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Calendar is requested only after the user chooses to connect their agenda. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Voice Commands: requested only when the person opens that screen and taps the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      These were stripped as "contributed by unreachable roadmap dependencies".
      That premise was wrong for three of them, and stripping a permission the
      code actually calls fails silently — nothing warns you, the API simply
      never succeeds.

      USE_BIOMETRIC / USE_FINGERPRINT: androidx.biometric is a live dependency
      and BiometricPrompt is used by the vaults, hidden apps and app lock.
      Without the permission canAuthenticate() never returns BIOMETRIC_SUCCESS,
      so every biometric gate in the app was permanently unavailable.

      WAKE_LOCK / RECEIVE_BOOT_COMPLETED: WorkManager needs both — the first to
      hold the CPU while a job runs, the second for its own boot receiver to
      restore scheduled work. PhotoBackupWorker enqueues a 24-hour
      PeriodicWorkRequest, so without them automatic backup stopped for good at
      the first reboot while the UI kept promising it ran daily.

      FOREGROUND_SERVICE stays removed: nothing calls startForeground and no
      work is expedited, so it would be a permission requested and never used.
    -->

    <application
        android:name=".CiyatoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Ciyato">

        <!--
          Lets Ciyato hand a file to another app without exposing a file:// URI,
          which throws FileUriExposedException on API 24+. Only used for files
          reached by direct path (All-files mode); SAF already returns content
          URIs. See FileAccess.shareableUri — every hand-off goes through it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Notification badge counts. The service was written and working, its
          own doc asserted it was "declared in AndroidManifest", and it never
          was — so Android never bound it and badgeCounts stayed empty forever
          while the notificationBadges setting defaulted to on.

          Binding still requires the person to grant notification access in
          system settings; Settings has a row for that. Until they do, the
          service simply never starts, which is why badges are treated as
          absent rather than zero.
        -->
        <service
            android:name=".services.CiyatoNotificationListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- LauncherHomeActivity is the actual Android HOME screen. -->
        <activity
            android:name=".LauncherHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/app_shortcuts" />
        </activity>

        <!-- MainActivity opens from another launcher / app icon. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tiles. Both are complete TileService implementations;
             they were previously undeclared, so the features were inert. -->
        <service
            android:name=".services.CiyatoWeatherTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Ciyato Weather"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".services.CiyatoFocusTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Ciyato Focus"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
