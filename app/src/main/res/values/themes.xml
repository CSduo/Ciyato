<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Ciyato base theme.
        windowBackground is transparent so Jetpack Compose draws the full-screen
        dark surface (CiyatoBg = #0B0F12) from Kotlin without a white flash.
        NoActionBar: we use TopAppBar from Compose, not the system action bar.
    -->
    <style name="Theme.Ciyato" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!--
            android:windowLightNavigationBar is API 27+ and minSdk is 26, so it
            lives in values-v27 instead. Declaring it here was a lint *error*,
            not a warning: on API 26 the attribute id does not exist, and OEMs
            have historically reused unclaimed ids for their own attributes, so a
            future-API attribute in a base theme can resolve to something else
            entirely on those builds. The v27 override supplies it where it is
            real; the light bars are already false by default below that.
        -->
    </style>
</resources>
