<?xml version="1.0" encoding="utf-8"?>
<!--
    Ciyato's launcher icon.

    In mipmap-anydpi rather than mipmap-anydpi-v26: adaptive icons need API 26
    and minSdk is 26, so the version qualifier could only ever select the same
    file. It also implied a pre-26 path that does not exist.

    The monochrome layer is what Android 13+ tints for themed icons. It was
    missing, which meant Ciyato — a launcher — was itself the odd icon out on a
    themed home screen.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
